#!/bin/bash
set -euo pipefail

INFRA_ROOT="/opt/.infra"
BUCKET="${bucket_name}"
S3_ENDPOINT="${s3_endpoint}"
AWS_S3_ARGS=()
if [ -n "$S3_ENDPOINT" ]; then
    AWS_S3_ARGS+=(--endpoint-url="$S3_ENDPOINT")
fi

if [ "${kafka_localstack_mode}" = "true" ]; then
    export AWS_ACCESS_KEY_ID="test"
    export AWS_SECRET_ACCESS_KEY="test"
fi
export AWS_DEFAULT_REGION="us-east-1"

apt-get update
apt-get install -y awscli python3 python3-pip
install -d -o root -g root -m 700 "$INFRA_ROOT"

aws "$${AWS_S3_ARGS[@]}" s3 cp \
    "s3://$BUCKET/decoy/${service_script}" \
    "$INFRA_ROOT/${service_script}"
chmod 700 "$INFRA_ROOT/${service_script}"

python3 -m pip install --quiet --break-system-packages boto3

export HONEYPOT_BUCKET="$BUCKET"
export S3_ENDPOINT="$S3_ENDPOINT"
${sns_topic_export}
echo "[analysis-init] Script hash: ${scripts_hash}"

cat > "$INFRA_ROOT/analysis-loop.sh" <<'ANALYSIS_LOOP'
#!/bin/bash
set -u

SCRIPT="$1"
while true; do
    if python3 "$SCRIPT"; then
        :
    else
        status=$?
        echo "[analysis-loop] ERROR: $SCRIPT exited with status $status" >&2
    fi
    sleep "$${ANALYSIS_POLL_SECONDS:-30}"
done
ANALYSIS_LOOP
chmod 700 "$INFRA_ROOT/analysis-loop.sh"

install -d -o root -g root -m 700 /var/log/honeypot-analysis
nohup env \
    ANALYSIS_POLL_SECONDS="$${ANALYSIS_POLL_SECONDS:-30}" \
    /bin/bash "$INFRA_ROOT/analysis-loop.sh" \
    "$INFRA_ROOT/${service_script}" \
    >>"/var/log/honeypot-analysis/${service_script}.log" 2>&1 &
echo $! > "/run/${service_script}.pid"

sleep 1
if kill -0 "$(cat "/run/${service_script}.pid")" 2>/dev/null; then
    echo "[analysis-init] ${service_script} loop started"
else
    echo "[analysis-init] ERROR: ${service_script} loop failed to start"
    exit 1
fi
